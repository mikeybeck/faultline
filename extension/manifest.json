{
  "manifest_version": 3,
  "name": "Faultline",
  "version": "0.1.1",
  "description": "Send local page errors to the Faultline inbox. Nothing to add to your app.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "111",
  "permissions": ["storage", "scripting", "alarms"],
  "optional_host_permissions": ["*://*/*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:9477/*",
    "http://localhost:9477/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.localhost/*",
        "*://*.test/*",
        "*://*.local/*",
        "*://*.ddev.site/*",
        "*://*.lndo.site/*"
      ],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://localhost/*",
        "*://127.0.0.1/*",
        "*://*.localhost/*",
        "*://*.test/*",
        "*://*.local/*",
        "*://*.ddev.site/*",
        "*://*.lndo.site/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "faultline@local",
      "strict_min_version": "128.0"
    }
  }
}
